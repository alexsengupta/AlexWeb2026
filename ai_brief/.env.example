# Copy to ai_brief/.env and fill in. The real .env is gitignored.
#
# ---------------------------------------------------------------------------
# The Google Drive folder that "Alex's Daily AI Brief" writes into.
# Get the ID from the folder URL:
#   https://drive.google.com/drive/folders/<THIS_PART_IS_THE_ID>
# ---------------------------------------------------------------------------
AI_BRIEF_FOLDER_ID=1xrD3wCdLT6lytymp968KJebSaystqAki

# ---------------------------------------------------------------------------
# Authentication -- set ONE of the two below.
# ---------------------------------------------------------------------------

# Option A (simplest): a Google Cloud API key, with the Drive folder shared
# "Anyone with the link can view". No key file, nothing to rotate.
AI_BRIEF_API_KEY=

# Option B: a service-account JSON key, for a folder that stays private.
# Only used when AI_BRIEF_API_KEY is empty.
# AI_BRIEF_SA_KEY=/var/www/Alex_web/ai_brief/service_account.json

# ---------------------------------------------------------------------------
# Optional overrides (defaults shown)
# ---------------------------------------------------------------------------
# AI_BRIEF_OUT=/var/www/Alex_web/ai_brief/briefs
# AI_BRIEF_MANIFEST=/var/www/Alex_web/ai_brief/index.json
