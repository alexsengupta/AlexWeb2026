    ["genom|molecular|microbiome|virol|phylogen",    "Genomic & laboratory science"],
    ["experiment|intervention|restoration",          "Experimental & intervention science"],
    ["remote sensing|imaging|\\bai\\b",              "Remote sensing & imaging"],
    ["governance|law|spatial planning",              "Law & governance"],
